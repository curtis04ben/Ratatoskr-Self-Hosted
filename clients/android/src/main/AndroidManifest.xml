<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission: talking to the user's Ratatoskr server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup/dataExtractionRules: no backups of the saved session
      (see res/xml/data_extraction_rules.xml).
      usesCleartextTraffic: servers are user-entered and often plain HTTP
      over Tailscale/LAN; the connect screen warns when it isn't HTTPS.
    -->
    <application
        android:label="Ratatoskr"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Ratatoskr">

        <!--
          configChanges: Compose redraws for rotation, resizing, dark mode
          etc. itself, so the activity isn't recreated, which would
          otherwise throw away the app state (and any half-typed entry).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Autofill (Phase 3.2): suggests saved logins in other apps and
          browsers, and offers to save new ones. Only active once the user
          picks Ratatoskr as the autofill service in system settings.
        -->
        <service
            android:name=".autofill.RatatoskrAutofillService"
            android:label="Ratatoskr"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!--
          Unlock / choose / save screens shown over another app. Its own
          empty task affinity and no recents entry, so finishing returns
          straight to that app.
        -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
