<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher masks this to its own shape (circle,
     squircle, ...). Made from shared/assets/ratatoskr-self-hosted.jpg: the
     foreground is the whole logo at 80% of the layer, so the round frame
     and the squirrel's ears stay inside the launcher's mask (checked on a
     Samsung squircle), on the logo's own background colour; the monochrome
     layer (the artwork alone) lets Android 13+ tint it for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
